<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.lior.plugin</id>
    <name>MineSpace Developer Tools</name>
    <vendor url="https://github.com/lior">lior</vendor>

    <description><![CDATA[
        <b>MineSpace Developer Tools</b> — 面向 WebStorm / IntelliJ IDEA 的开发效率插件。<br><br>
        <b>Console Helper</b> — 快速日志辅助工具：<br>
        <ul>
            <li>光标处/选中变量一键插入日志语句</li>
            <li>支持 console.log / console.debug / DEBUG_LOG / print 等多种函数</li>
            <li>自定义前缀、文件名、行号标注</li>
            <li>浏览器控制台 CSS 颜色样式与终端 ANSI 颜色</li>
            <li>随机颜色模式，轻松区分不同日志</li>
            <li>复杂对象自动 JSON.stringify，告别 [object Object]</li>
            <li>一键清理当前文件中的所有日志语句</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
            serviceImplementation="com.lior.plugin.consoleHelper.settings.ConsoleHelperSettings"/>

        <applicationConfigurable
            parentId="editor"
            instance="com.lior.plugin.consoleHelper.settings.ConsoleHelperSettingsConfigurable"
            id="com.lior.plugin.consoleHelper.settings.ConsoleHelperSettingsConfigurable"
            displayName="Console Helper"/>
    </extensions>

    <actions>
        <group id="ConsoleHelper.ActionGroup"
               text="Console Helper"
               description="Console Helper 日志工具"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <action id="ConsoleHelper.InsertLog"
                class="com.lior.plugin.consoleHelper.actions.InsertLogAction"
                text="插入日志语句"
                description="在光标处或选中变量下方插入日志语句">
            <add-to-group group-id="ConsoleHelper.ActionGroup" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift L"/>
        </action>

        <action id="ConsoleHelper.ClearLogs"
                class="com.lior.plugin.consoleHelper.actions.ClearLogsAction"
                text="清理所有日志语句"
                description="删除当前文件中所有匹配的日志语句">
            <add-to-group group-id="ConsoleHelper.ActionGroup" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift D"/>
        </action>
    </actions>
</idea-plugin>
