<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.lior.plugin</id>
    <name>MineSpace Developer Tools</name>
    <vendor url="https://github.com/lior">lior</vendor>

    <description><![CDATA[
        <b>MineSpace Developer Tools</b> — 面向 WebStorm / IntelliJ IDEA 的开发效率插件。<br><br>

        <b>Console Helper</b> — 快速日志工具：<br>
        <ul>
            <li>光标处/选中变量一键插入日志语句（Alt+Shift+L）</li>
            <li>支持 console.log / console.debug / DEBUG_LOG / print 等多种函数</li>
            <li>自定义前缀、文件名、行号标注</li>
            <li>浏览器控制台 CSS 颜色样式与终端 ANSI 颜色、随机颜色</li>
            <li>复杂对象自动 JSON.stringify</li>
            <li>一键清理所有日志（Alt+Shift+D）</li>
        </ul>

        <b>i18n Helper</b> — 国际化辅助工具：<br>
        <ul>
            <li>代码行尾内联显示 i18n key 对应翻译，语言文件变更自动刷新（Alt+Shift+R 手动刷新）</li>
            <li>鼠标悬停在 i18n key 上弹出气泡，一次展示所有语言的翻译对照</li>
            <li>底部 i18n 面板：Table View / Tree View 双视图，展示项目全量翻译条目</li>
            <li>搜索框实时过滤，同时匹配 key 名称与翻译内容，Table / Tree 联动更新</li>
            <li>支持 i18next / vue-i18n / react-intl / ngx-translate / Flutter 等主流框架，自动检测</li>
            <li>支持 JSON / YAML / Properties / JS / TS 格式的 locale 文件</li>
            <li>支持语言子目录（zh-CN/）与文件名（messages_zh_CN.properties）两种布局</li>
            <li>Glob patterns 路径配置，自动检测可用语言列表，支持 BCP 47 语言代码</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- ── Console Helper ─────────────────────────────────────── -->
        <applicationService
            serviceImplementation="com.lior.plugin.consoleHelper.settings.ConsoleHelperSettings"/>
        <applicationConfigurable
            parentId="editor"
            instance="com.lior.plugin.consoleHelper.settings.ConsoleHelperSettingsConfigurable"
            id="com.lior.plugin.consoleHelper.settings.ConsoleHelperSettingsConfigurable"
            displayName="Console Helper"/>

        <!-- ── i18n Helper ────────────────────────────────────────── -->
        <applicationService
            serviceImplementation="com.lior.plugin.i18n.settings.I18nSettings"/>
        <projectService
            serviceImplementation="com.lior.plugin.i18n.service.LocaleFileService"/>
        <applicationConfigurable
            parentId="editor"
            instance="com.lior.plugin.i18n.settings.I18nSettingsConfigurable"
            id="com.lior.plugin.i18n.settings.I18nSettingsConfigurable"
            displayName="i18n"/>

        <!-- 行尾翻译注释（适用于所有文件类型）-->
        <editorLinePainter
            implementation="com.lior.plugin.i18n.annotation.I18nEditorLinePainter"/>

        <!-- 鼠标悬浮气泡：光标停在 i18n key 上时展示所有语言的翻译 -->
        <editorFactoryListener
            implementation="com.lior.plugin.i18n.annotation.I18nEditorHoverHandler"/>

        <!-- i18n Tool Window（底部面板，Table / Tree 双视图）-->
        <toolWindow id="i18n"
                    displayName="i18n"
                    factoryClass="com.lior.plugin.i18n.toolwindow.I18nToolWindowFactory"
                    anchor="bottom"
                    canCloseContents="false"/>


    </extensions>

    <actions>
        <!-- ── Console Helper ─────────────────────────────────────── -->
        <group id="ConsoleHelper.ActionGroup"
               text="Console Helper"
               description="Console Helper 日志工具"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <action id="ConsoleHelper.InsertLog"
                class="com.lior.plugin.consoleHelper.actions.InsertLogAction"
                text="插入日志语句"
                description="在光标处或选中变量下方插入日志语句">
            <add-to-group group-id="ConsoleHelper.ActionGroup" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift L"/>
        </action>

        <action id="ConsoleHelper.ClearLogs"
                class="com.lior.plugin.consoleHelper.actions.ClearLogsAction"
                text="清理所有日志语句"
                description="删除当前文件中所有匹配的日志语句">
            <add-to-group group-id="ConsoleHelper.ActionGroup" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift D"/>
        </action>

        <!-- ── i18n Helper ────────────────────────────────────────── -->
        <group id="I18n.ActionGroup"
               text="i18n Helper"
               description="i18n 国际化工具"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <action id="I18n.RefreshTranslations"
                class="com.lior.plugin.i18n.actions.RefreshTranslationsAction"
                text="刷新翻译缓存"
                description="重新加载所有 locale 文件并刷新行尾翻译注释">
            <add-to-group group-id="I18n.ActionGroup" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift R"/>
        </action>
    </actions>
</idea-plugin>
